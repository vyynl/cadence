<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cadence API key</title>
  </head>
  <body>
    <h1>Your Cadence API key</h1>
    <p>This value is shown once. Store it now:</p>
    <pre style="white-space: pre-wrap; word-break: break-all;">{@plaintext}</pre>
    <p>Put it in <code>~/.config/cadence/env</code> as <code>CAD_AUTH_TOKEN</code>.</p>
  </body>
</html>
