<div class="auth-shell">
  <section class="auth-card" aria-labelledby="token-title">
    <div class="auth-brand">
      <Cadence.ServerWeb.Components.Brand.logo size={24} class="brand-logo" />
      <span>Cadence</span>
    </div>

    <header class="auth-header">
      <h1 id="token-title">Your Cadence API key</h1>
      <p class="auth-lede">This value is shown once. Store it now.</p>
    </header>

    <pre class="token-value">{@plaintext}</pre>

    <p class="auth-note">
      Put it in <code>~/.config/cadence/env</code> as <code>CAD_AUTH_TOKEN</code>.
    </p>

    <a class="admin-button button-primary auth-submit" href="/account">Back to account</a>
    <p class="auth-note"><a href="/auth/tokens/new">Create another key</a></p>
  </section>
</div>
