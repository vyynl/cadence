<div class="auth-shell">
  <section class="auth-card" aria-labelledby="token-title">
    <div class="auth-brand">
      <Cadence.ServerWeb.Components.Brand.logo size={24} class="brand-logo" />
      <span>Cadence</span>
    </div>

    <header class="auth-header">
      <h1 id="token-title">Create a daemon token</h1>
      <p class="auth-lede">Signed in as {@email}.</p>
    </header>

    <form method="post" action={~p"/auth/tokens"} class="auth-form">
      <input type="hidden" name="_csrf_token" value={@csrf} />
      <label class="auth-field">
        <span>Key name</span>
        <input
          type="text"
          name="name"
          value="daemon"
          maxlength="80"
          autocomplete="off"
          spellcheck="false"
          required
          autofocus
        />
      </label>
      <button type="submit" class="admin-button button-primary auth-submit">Create key</button>
    </form>

    <p class="auth-note">
      The key is shown once. Store it in <code>~/.config/cadence/env</code>
      as <code>CAD_AUTH_TOKEN</code>.
    </p>
  </section>
</div>
