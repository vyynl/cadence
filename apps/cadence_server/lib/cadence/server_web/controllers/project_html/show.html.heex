<article>
  <header>
    <p class="eyebrow">Project</p>
    <h1>{@project.name}</h1>
    <p class="slug">/{@project.slug}</p>
  </header>

  <section :if={@preview_node} class="preview">
    <h2>Preview node</h2>

    <dl>
      <dt>Message</dt>
      <dd>{@preview_node.message || "(no message)"}</dd>

      <dt>Flags</dt>
      <dd>{format_flags(@preview_node.flags)}</dd>

      <dt>Committed</dt>
      <dd>
        <time datetime={DateTime.to_iso8601(@preview_node.created_at)}>
          {format_time(@preview_node.created_at)}
        </time>
      </dd>

      <dt>Commit</dt>
      <dd><code>{String.slice(@preview_node.git_commit_sha, 0, 12)}</code></dd>
    </dl>

    <p class="note">README and DAG rendering arrive in the next slices.</p>
  </section>

  <p :if={is_nil(@preview_node)} class="empty">No commits yet.</p>
</article>
