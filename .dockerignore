# Only apps/ and config/ are COPYed into the build stages; everything else is
# excluded to keep the build context small and to guarantee a secret or a local
# env file can never land in an image layer.

_build
deps
.git
.gitignore
.claude
.opencode
.elixir_ls
node_modules
coverage
cover

# Docs and packaging are not build inputs.
*.md
docker
docker-compose.yml
docker-compose.demo.yml
docker-compose.daemon.yml
.github
examples
scripts
cadence.nvim
lua
plugin

# Build/CI descriptors, not sources.
Dockerfile*
.dockerignore

# Never ship secrets or local state.
.env
.env.*
*.env
*.db
*.db-shm
*.db-wal
erl_crash.dump
tmp
