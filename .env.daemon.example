# Cadence daemon configuration — canonical reference.
#
#   cp .env.daemon.example .env.daemon && chmod 600 .env.daemon
#
# The daemon does not parse this file. It reads the process environment, so
# load the file into it:
#
#   POSIX shell (host release)   set -a; . ./.env.daemon; set +a
#   systemd (host release)       EnvironmentFile=%h/.config/cadence/env
#   Docker (compose)             env_file: .env.daemon (docker-compose.daemon.yml)
#
# Load the file whole. `env $(cat .env.daemon | xargs)` splits values on
# whitespace and strips quotes, so a token with punctuation arrives corrupted.
#
# Every setting below is optional; the server URL and token are what turn sync
# on. Sync is one-way in each direction: the daemon is the source of commits
# (it pushes nodes it watches and commits) and the server is the coordination
# point (it stores nodes, resolves melds, and serves the web UI and other
# machines). Nothing in the server writes into a working tree.

# --- Server + auth ---------------------------------------------------------
# Sync target, with scheme and no trailing slash. Valid: http(s)://host[:port].
# Default: unset (offline; commits stay local and nothing syncs).
# Consequence of a wrong value: the daemon runs, commits locally, and the sync
# worker logs connection failures every CAD_SYNC_INTERVAL_MS.
CAD_SERVER_URL=https://cadence.example.com

# Personal access token for the sync API, minted in the server UI:
# sign in, open /auth/tokens/new, name it after the machine, copy it once (the
# server stores only a SHA-256 hash). Every sync request is authenticated as the
# account that created it; there is no token file.
# Default: unset (offline). Empty or wrong: every sync request gets 401 and the
# node stays in the local ledger until a token is fixed and the daemon restarts.
CAD_AUTH_TOKEN=cad_replace_with_a_minted_token

# --- State ----------------------------------------------------------------
# SQLite database, per-project Git stores, and `daemon.sock` live here.
# Default: ~/.local/state/cadence (resolved from the process user's home). The
# container image defaults to /data/state, where docker-compose.daemon.yml
# mounts its volume.
# Consequence: changing this on an existing install starts from an empty
# database; the old history, ledger, and socket stay behind.
# CAD_STATE_DIR=/home/you/.local/state/cadence

# --- Projects and watching ------------------------------------------------
# There is no watch-dirs variable. A project is registered over the daemon's
# Unix socket with its absolute work_dir, and that directory is what gets
# watched:
#
#   bin/cadence_daemon eval 'IO.inspect(Cadence.Daemon.Release.register("Name", "slug", "/abs/path"))'
#
# or `mix cad.register NAME SLUG WORK_DIR` from a checkout, or `POST /projects`
# on daemon.sock. Registration starts the watcher; only a file change after
# registration produces the first node.
#
# Backend for `file_system`. Valid: fs_inotify (Linux), fs_poll, fs_mac (macOS).
# An unrecognised value falls back to the platform default.
# Default: fs_inotify on Linux, fs_poll on macOS. fs_inotify requires the
# `inotifywait` executable (inotify-tools); the published image includes it.
# Consequence if missing: the watcher logs a bootstrap error and retries every
# 5 s, so nothing is committed. fs_poll works everywhere and polls every second.
# CAD_WATCH_BACKEND=fs_inotify

# Idle time before a snapshot is committed, in milliseconds. Default: 2000.
# Lower: more nodes from one editing burst. Higher: fewer, coarser nodes.
# CAD_WATCH_DEBOUNCE_MS=2000

# Comma-separated entry names skipped when snapshotting; `.git` is always
# skipped. Default: _build,deps,node_modules,.venv,venv,__pycache__,.elixir_ls,target
# Consequence: a build directory left out of the list becomes part of history.
# CAD_IGNORE=_build,deps,node_modules,.venv,venv,__pycache__,.elixir_ls,target

# --- Sync behaviour -------------------------------------------------------
# Default: true. false keeps the daemon fully local even with a URL and token.
# CAD_SYNC_ENABLED=true

# Optional notification socket (Phoenix Channels) that shortens the wait for
# other machines' pushes. Default: true. false disables only the socket;
# CAD_SYNC_INTERVAL_MS polling still syncs.
# CAD_SYNC_CHANNEL_ENABLED=true

# Background pass interval and retry backoff, in milliseconds.
# Defaults: 30000 each.
# CAD_SYNC_INTERVAL_MS=30000
# CAD_SYNC_RETRY_BACKOFF_MS=30000

# Automatic retries per pending node, and nodes per push batch.
# Defaults: 10 and 100.
# CAD_SYNC_MAX_ATTEMPTS=10
# CAD_SYNC_PUSH_LIMIT=100

# HTTP timeout for background requests and for a synchronous union, in
# milliseconds. Defaults: 5000 and 180000. The union timeout must stay above
# the server's (CAD_MELD_RETRY_ATTEMPTS + 1) × CAD_MELD_TIMEOUT_MS + backoff,
# or a conflicted union times out here while it is still running there.
# CAD_SYNC_REQUEST_TIMEOUT_MS=5000
# CAD_SYNC_UNION_TIMEOUT_MS=180000

# Existence-handshake chunk size. Default: 5000. Keep at or below the server's
# CAD_SYNC_EXISTS_LIMIT; a larger value makes the handshake fall back to a full
# push (correct, just slower).
# CAD_SYNC_EXISTS_LIMIT=5000

# --- AI (optional) --------------------------------------------------------
# Used for commit messages and, with CAD_DOCS_ENABLED, doc generation.
# Defaults: deepseek / unset / deepseek-chat / https://api.deepseek.com
# Consequence with no API key: the daemon still commits; messages fall back to
# the file-change summary and doc jobs are marked skipped.
# CAD_LLM_PROVIDER=deepseek
# CAD_LLM_API_KEY=
# CAD_LLM_MODEL=deepseek-chat
# CAD_LLM_BASE_URL=https://api.deepseek.com

# LLM request timeout in milliseconds and calls allowed per window.
# Defaults: 5000, 10 calls / 60000 ms.
# CAD_LLM_TIMEOUT_MS=5000
# CAD_LLM_RATE_LIMIT=10
# CAD_LLM_RATE_SCALE=60000

# Documentation automation. Default: true. false disables every doc job,
# including a manual :CadDocSync.
# CAD_DOCS_ENABLED=true

# --- Identity written into local commits ----------------------------------
# Defaults: the zero UUID and cadence <cadence@local>. The UUID is the
# created_by written on local nodes until the server maps them to an account.
# CAD_LOCAL_USER_ID=00000000-0000-0000-0000-000000000000
# CAD_GIT_AUTHOR_NAME=cadence
# CAD_GIT_AUTHOR_EMAIL=cadence@local
