# Elixir
/_build/
/cover/
/apps/*/cover/
/deps/
/doc/
/.fetch
erl_crash.dump
*.ez
*.beam
/config/*.secret.exs
.elixir_ls/

# Umbrella
/apps/*/_build/
/apps/*/deps/

# Local. The daemon reads its own file, which `*.env` does not match; ignore it
# explicitly so a minted token can never be committed. The examples stay tracked.
.env
.env.daemon
.env.local
*.env
*.db
*.db-shm
*.db-wal

# Editor
.DS_Store
.idea/
.vscode/
