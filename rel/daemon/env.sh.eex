#!/bin/sh
# The Cadence daemon is a single local process: it never connects to another
# Erlang node. Turning distribution off avoids opening an epmd/distribution
# port, writing a cookie, and taking the fixed `cadence_daemon` node name (two
# daemons can run side by side with different CAD_STATE_DIR).
#
# Consequently `bin/cadence_daemon stop|remote|rpc` are not available. Stop the
# daemon with SIGTERM — `systemctl --user stop cadence-daemon`, Ctrl-C in the
# foreground, or `kill <pid>`. Releases handle SIGTERM as a graceful shutdown.
export RELEASE_DISTRIBUTION=none
