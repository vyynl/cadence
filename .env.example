# Cadence server configuration. This file is the canonical reference for every
# variable the compose stack reads; the deployment docs point here instead of
# repeating it.
#
#   cp .env.example .env     # edit the two required values
#   docker compose up -d
#
# Only CAD_PUBLIC_URL and CAD_ADMIN_EMAIL need a value. Everything else may be
# left as shown; blank means "let the stack generate or default it".

# ─── Required ───────────────────────────────────────────────────────────────
# Public origin the server is reachable at: OAuth callbacks, passkey origin,
# public links, session cookies. Must include the scheme; a trailing slash is
# stripped. Wrong value ⇒ dead links, rejected passkeys, redirects to the wrong
# host, and (behind TLS) a secure-cookie sign-in loop.
CAD_PUBLIC_URL=https://cadence.example.com

# Email of the first admin account, created once by the `bootstrap` service.
# No mail is sent. Empty ⇒ no account is created and nobody can sign in;
# a password without an email fails the bootstrap step loudly.
CAD_ADMIN_EMAIL=admin@example.com

# ─── Auto-generated (leave blank) ───────────────────────────────────────────
# Phoenix secret key base: 64 random bytes, hex when generated. Changing it
# invalidates every session and makes stored TOTP secrets undecryptable.
CAD_SECRET_KEY_BASE=

# PostgreSQL password. Generated hex is URL-safe; a manual value containing
# @ : / or ? breaks the derived database URL. Changing it after the first boot
# does not change the role's password (Postgres reads it only when it
# initializes an empty data directory).
CAD_DB_PASS=

# Password for the first admin account (12–72 characters). Generated on the
# first start and printed once by `docker compose logs secrets`. Set it before
# the first boot to choose your own; remove it once the account exists.
CAD_ADMIN_PASSWORD=

# ─── Optional ───────────────────────────────────────────────────────────────
# Image the stack runs (published by the repo's release workflow). Pin a version
# tag for reproducible upgrades; `latest` moves under you.
CAD_SERVER_IMAGE=ghcr.io/vyynl/cadence:latest

# Host interface and port the app publishes on. Loopback suits the bundled Caddy
# profile and a proxy on this host; 0.0.0.0 exposes plain HTTP, so firewall it.
# The app itself always listens on 4000 inside the container.
CAD_HTTP_BIND=127.0.0.1
CAD_HTTP_PORT=4000

# TLS, read only when the stack runs with `--profile tls`.
#   auto     Let's Encrypt; needs public DNS and ports 80/443 reachable.
#   internal Caddy's local CA; clients must trust its root certificate.
# Any other value makes Caddy exit. Omit the profile entirely to use your own
# reverse proxy.
CAD_TLS_MODE=auto

# Hostname Caddy serves. Blank ⇒ the host of CAD_PUBLIC_URL, which is correct
# unless Caddy answers on a name that is not the public origin.
CAD_PHX_HOST=

# Host ports for bundled Caddy. Raise them when 80/443 are taken; only useful
# with `internal` TLS or an external proxy, since ACME needs the real ports.
CAD_CADDY_HTTP_PORT=80
CAD_CADDY_HTTPS_PORT=443

# PostgreSQL role and database created on first boot. Keep them URL-safe.
# Changing the database name after first boot makes the app look at an empty
# database instead of your data.
CAD_DB_USER=cadence
CAD_DB_NAME=cadence

# Ecto connection pool per server process. Raise it for a fleet of daemons; the
# default is comfortable for a small team.
CAD_DB_POOL_SIZE=10

# Display name for the first admin account. Blank ⇒ derived from the email.
CAD_ADMIN_NAME=

# ─── Optional: AI features ──────────────────────────────────────────────────
# LLM behind generated commit messages, meld resolution and doc automation.
# A blank key skips those features; nothing else breaks.
CAD_LLM_PROVIDER=deepseek
CAD_LLM_API_KEY=
CAD_LLM_MODEL=deepseek-chat
CAD_LLM_BASE_URL=https://api.deepseek.com

# Docker action runner. false ⇒ no action runs, run pages or downloads, and the
# docker-proxy service can be removed from the stack. The volume name is also
# the compose volume name, so the daemon can mount it into action containers.
CAD_ACTIONS_ENABLED=true
CAD_ACTIONS_VOLUME=cadence_actions

# ─── Optional: sign-in extras ───────────────────────────────────────────────
# OAuth providers. Blank hides the button. Redirect URI to register:
# <CAD_PUBLIC_URL>/auth/user/<github|google>/callback
CAD_OAUTH_GITHUB_CLIENT_ID=
CAD_OAUTH_GITHUB_CLIENT_SECRET=
CAD_OAUTH_GOOGLE_CLIENT_ID=
CAD_OAUTH_GOOGLE_CLIENT_SECRET=

# Passkeys / security keys. Enabling these with a mismatched RP ID or origin
# fails the boot; the RP ID is a hostname only and is permanent, because
# changing it invalidates every registered credential.
CAD_WEBAUTHN_ENABLED=false
CAD_WEBAUTHN_RP_ID=
CAD_WEBAUTHN_ORIGIN=
CAD_WEBAUTHN_RP_NAME=Cadence

# TOTP secret encryption key (32 bytes, base64, or a passphrase). Blank ⇒
# derived from CAD_SECRET_KEY_BASE. Rotating it locks out every enrolled
# account until its TOTP is reset.
CAD_TOTP_KEY=
