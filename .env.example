# --- Public server ---------------------------------------------------------
# Host port published by docker-compose.prod.yml; the app listens on 4000.
CAD_PHX_HOST=cadence.example.com
CAD_PUBLIC_URL=https://cadence.example.com
CAD_HTTP_PORT=4000
CAD_SECRET_KEY_BASE=generate_me
CAD_LIVE_VIEW_SALT=generate_me
CAD_TOKEN_SIGNING_SECRET=generate_me
# Read by the app; for the compose stack point it at the `postgres` service.
CAD_DATABASE_URL=ecto://cadence:password@postgres:5432/cadence
# Read only by docker-compose.prod.yml (postgres service); keep the user/password
# in CAD_DATABASE_URL above consistent with these.
CAD_DB_USER=cadence
CAD_DB_PASS=password
CAD_DB_NAME=cadence
CAD_SERVER_IMAGE=cadence-server:prod
CAD_DB_POOL_SIZE=10
CAD_GIT_STORE_PATH=/data/git
CAD_SYNC_PULL_LIMIT=100
# Also read by the daemon as the handshake chunk size; keep at or below the cap.
CAD_SYNC_EXISTS_LIMIT=5000
# Ordinary pushes carry one parent; an owner may publish an imported Git merge
# with up to this many parents (spec §10.2).
CAD_SYNC_MAX_PUSH_PARENTS=8
# Sync-scoped body limit (browser/public routes keep Plug's 8 MiB default).
CAD_SYNC_MAX_BODY_BYTES=67108864
# Per-user bound on /sync/* requests; one user's daemon cannot starve another's.
# 0 disables the limiter. The meld limiter stays the inner, per-project bound.
CAD_SYNC_RATE_LIMIT=300
CAD_SYNC_RATE_SCALE=60000
CAD_DAG_INTRO_MS=1200
# Newest nodes rendered in the public DAG; older commits stay in the data.
CAD_DAG_MAX_NODES=150
# Skip the DAG intro animation when the project has more nodes than this
# (non-positive falls back to 60).
CAD_DAG_INTRO_MAX_NODES=60
CAD_FILE_MAX_BYTES=524288
CAD_FILE_MAX_LINES=2000
CAD_README_MAX_BYTES=262144
CAD_TREE_MAX_ENTRIES=1000
# Max changed files listed on a public proposal page.
CAD_PROPOSAL_MAX_FILES=200
# Rendered public proposal-result payloads kept in-process; 0 disables.
CAD_PROPOSAL_CACHE_ENTRIES=256
CAD_SCAN_MAX_FILES=10000
CAD_SCAN_MAX_BYTES=16777216

# Meld agent (server side; spec §6.5)
# A synchronous union can take (CAD_MELD_RETRY_ATTEMPTS + 1) x
# CAD_MELD_TIMEOUT_MS + CAD_MELD_RETRY_BACKOFF_MS, so the daemon's
# CAD_SYNC_UNION_TIMEOUT_MS must budget above that.
CAD_MELD_TIMEOUT_MS=60000
CAD_MELD_RATE_LIMIT=5
CAD_MELD_RATE_SCALE=60000
CAD_MELD_MAX_OPS=50
CAD_MELD_MAX_FILE_BYTES=262144
CAD_MELD_CONTEXT_BYTES=65536
CAD_MELD_RETRY_ATTEMPTS=1
CAD_MELD_RETRY_BACKOFF_MS=500

# Storage maintenance (spec §13 Phase 7b)
# A run packs loose objects; a later verified run removes the loose copies, so
# the store can hold pack + loose copies (up to 2x) until the next run.
CAD_REPACK_ENABLED=true
CAD_REPACK_MIN_OBJECTS=1000
CAD_REPACK_MIN_BYTES=67108864
# Backstop interval and push-trigger failure cooldown; 0 disables both
CAD_REPACK_INTERVAL_MS=21600000
# Wall-clock bound for one background run; the worker kills a task past it
# (0 disables). The manual `mix cadence.repack` task is not interrupted.
CAD_REPACK_TIMEOUT_MS=600000
CAD_REPACK_MAX_PACK_BYTES=67108864

# Docker actions (spec §8)
CAD_ACTIONS_ENABLED=true
CAD_DOCKER_SOCKET=http://localhost:2375
CAD_ARTIFACT_PATH=/data/artifacts
CAD_ACTIONS_VOLUME=cadence_actions
CAD_ACTIONS_VOLUME_PATH=/data/actions
CAD_ACTIONS_MAX_MANIFEST_BYTES=32768
CAD_ACTIONS_MAX_ACTIONS=20
CAD_ACTIONS_TIMEOUT_MS=120000
CAD_ACTIONS_BUILD_TIMEOUT_MS=300000
# Per-project bound on running action containers (0 = unlimited).
CAD_ACTIONS_MAX_CONCURRENT_RUNS=1
# Maximum waiting (:queued) runs per project; 0 = unlimited.
CAD_ACTIONS_MAX_QUEUED_RUNS=20
# Drain queued runs once when the server boots.
CAD_ACTIONS_DISPATCH_ON_BOOT=true
# Delete terminal runs' logs/artifacts after this many days (0 = keep).
CAD_ACTIONS_ARTIFACT_RETENTION_DAYS=30
# Retention backstop interval (0 = manual `mix cadence.actions_sweep` only).
CAD_ACTIONS_RETENTION_INTERVAL_MS=21600000
# Cap on runs examined per retention pass.
CAD_ACTIONS_RETENTION_BATCH=500
# Keep the newest N action images per project (0 = keep all).
CAD_ACTIONS_IMAGE_RETENTION_PER_PROJECT=5
CAD_ACTIONS_MAX_CPUS=1
CAD_ACTIONS_MEMORY_MB=512
CAD_ACTIONS_PIDS_LIMIT=256
CAD_ACTIONS_NETWORK=none
CAD_ACTIONS_BUILD_NETWORK=none
CAD_DOCKER_API_VERSION=v1.45
CAD_ACTIONS_MAX_LOG_BYTES=1048576
CAD_ACTIONS_MAX_ARTIFACT_BYTES=33554432
CAD_OAUTH_GITHUB_CLIENT_ID=
CAD_OAUTH_GITHUB_CLIENT_SECRET=
CAD_OAUTH_GOOGLE_CLIENT_ID=
CAD_OAUTH_GOOGLE_CLIENT_SECRET=
# Demo-only UI hint on /sign-in and /sign-in/totp (seeded accounts are
# pre-enrolled; it prints the `mix cadence.totp` command). Never enable in prod.
# CAD_DEMO_HINTS=false
# Local accounts and sessions (spec §7.4). Accounts are created by the operator
# with `mix cadence.user`; there is no public registration. TOTP is mandatory
# for local password accounts by default. Passwords are Argon2id.
CAD_AUTH_PASSWORD_MIN_LENGTH=12
CAD_AUTH_TOTP_REQUIRED=true
CAD_AUTH_TOTP_ISSUER=Cadence
# Optional: 32 raw bytes, base64, or a passphrase. Absent ⇒ derived from
# CAD_SECRET_KEY_BASE. Rotating it invalidates stored TOTP secrets.
# CAD_TOTP_KEY=
CAD_AUTH_SUDO_MINUTES=20
CAD_AUTH_LOGIN_IP_RATE_LIMIT=20
CAD_AUTH_LOGIN_ACCOUNT_RATE_LIMIT=5
CAD_AUTH_LOGIN_RATE_SCALE=60000
CAD_AUTH_TOTP_RATE_LIMIT=10
CAD_AUTH_TOTP_RATE_SCALE=300000
CAD_SESSION_TTL_DAYS=14
CAD_SESSION_REISSUE_DAYS=7
# Passkeys / WebAuthn (FIDO2), disabled by default. RP ID is a hostname only
# and is permanent: changing it invalidates every registered credential. In
# production CAD_WEBAUTHN_ORIGIN is required and must be the exact https origin
# users see (a TLS-terminating proxy makes the internal request host/scheme
# useless for verification).
CAD_WEBAUTHN_ENABLED=false
CAD_WEBAUTHN_RP_ID=localhost
CAD_WEBAUTHN_RP_NAME=Cadence
CAD_WEBAUTHN_ORIGIN=
CAD_WEBAUTHN_USER_VERIFICATION=required
CAD_WEBAUTHN_TIMEOUT_MS=120000
CAD_WEBAUTHN_MAX_CREDENTIALS=10
CAD_WEBAUTHN_RATE_LIMIT=10
CAD_WEBAUTHN_RATE_SCALE=60000
CAD_LLM_PROVIDER=deepseek
CAD_LLM_API_KEY=sk-...
CAD_LLM_MODEL=deepseek-chat
CAD_LLM_BASE_URL=https://api.deepseek.com
CAD_LLM_TIMEOUT_MS=5000
CAD_LLM_RATE_LIMIT=10
CAD_LLM_RATE_SCALE=60000
CAD_LLM_DIFF_MAX_BYTES=32768
CAD_LLM_RETRY_ATTEMPTS=3
CAD_LLM_RETRY_INITIAL_MS=0
CAD_LLM_RETRY_BACKOFF_MS=5000

# Documentation automation (daemon side; spec §9). AI features are optional:
# without CAD_LLM_API_KEY the daemon commits code-only and marks docs skipped.
CAD_DOCS_ENABLED=true
CAD_DOCS_TIMEOUT_MS=30000
CAD_DOCS_RATE_LIMIT=5
CAD_DOCS_RATE_SCALE=60000
CAD_DOCS_RETRY_ATTEMPTS=3
CAD_DOCS_RETRY_BACKOFF_MS=5000
CAD_DOCS_MAX_OPS=20
CAD_DOCS_MAX_FILES=200
CAD_DOCS_MAX_FILE_BYTES=262144
CAD_DOCS_CONTEXT_BYTES=65536
CAD_DOCS_DIFF_MAX_BYTES=32768

# Daemon-local behavior
CAD_STATE_DIR=~/.local/state/cadence
CAD_LOCAL_USER_ID=00000000-0000-0000-0000-000000000000
CAD_WATCH_DEBOUNCE_MS=2000
# Watcher backend: fs_inotify (Linux default), fs_poll (macOS default and the
# no-dependency fallback), fs_mac (opt-in on macOS)
# CAD_WATCH_BACKEND=fs_inotify
CAD_GIT_AUTHOR_NAME=cadence
CAD_GIT_AUTHOR_EMAIL=cadence@local
CAD_IGNORE=_build,deps,node_modules,.venv,venv,__pycache__,.elixir_ls,target

# Cloud sync (absence of URL/token means offline mode)
CAD_SERVER_URL=
CAD_AUTH_TOKEN=
CAD_SYNC_ENABLED=true
CAD_SYNC_CHANNEL_ENABLED=true
CAD_SYNC_REQUEST_TIMEOUT_MS=5000
CAD_SYNC_UNION_TIMEOUT_MS=180000
CAD_SYNC_INTERVAL_MS=30000
CAD_SYNC_RETRY_BACKOFF_MS=30000
CAD_SYNC_MAX_ATTEMPTS=10
CAD_SYNC_PUSH_LIMIT=100
# Git import (spec §5.7, §13 Phase 9)
# One job at a time; these bound the walk, object copy, wall clock, and batch.
CAD_IMPORT_MAX_COMMITS=2000
CAD_IMPORT_MAX_BLOB_BYTES=8388608
CAD_IMPORT_MAX_SECONDS=1800
CAD_IMPORT_ALLOW_SHALLOW=false
CAD_IMPORT_PUSH_BATCH=100
CAD_DIFF_MAX_FILES=20
CAD_DIFF_MAX_LINES_PER_FILE=400
CAD_DIFF_MAX_BYTES=262144
