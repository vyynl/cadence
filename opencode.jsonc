{
  "$schema": "https://opencode.ai/config.json",

  // Elixir formatter: runs `mix format $FILE` from the project root after an
  // edit tool writes a .ex/.exs/.eex/.heex file. Keeps the tree formatted
  // between explicit `mix format` runs (AGENTS.md §11).
  "formatter": {
    "mix": {}
  },

  // Destructive operations ask first. The default policy is allow, so these
  // are the only prompts added on top of it. Last matching rule wins; keep the
  // broad/default behaviour implicit and list only the guards.
  "permissions": [
    { "action": "shell", "resource": "mix ecto.drop *", "effect": "ask" },
    { "action": "shell", "resource": "mix ecto.reset *", "effect": "ask" },
    { "action": "shell", "resource": "git push --force*", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" }
  ]
}
